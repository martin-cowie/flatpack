[server]
# trace, debug, info, warn or error
log_level = "info"

[kafka]
brokers = "localhost:19092"
default_topic = "rust-topic"
message_timeout_ms = 5000
auth_timeout_ms = 5000

# Kafka decides who may log in. With PLAINTEXT, any username and password is accepted.
security_protocol = "PLAINTEXT"

# To check logins against Kafka credentials instead:
# security_protocol = "SASL_PLAINTEXT"
# sasl_mechanism = "SCRAM-SHA-256"   # or "SCRAM-SHA-512", or "PLAIN"
